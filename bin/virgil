#!/usr/bin/env python3
"""Author a trail for the virgil nvim plugin.

A trail is an ordered walk through a flow: file, line range, title, note. It is
compiled to $XDG_DATA_HOME/virgil/<repo-key>/<id>.json (see the README's
"Storage" section), where nvim's watcher picks it up.
The reader opens it with :Virgil and steps with :VirgilNext and
:VirgilPrev.

  virgil create [--from FILE] [--root DIR] [--author NAME]
                [--new | --expect-rev REV]

      Compile a draft (stdin, or --from) into a trail. The draft is JSON:

        {
          "id": "login-flow",                    optional; slugged from title
          "title": "How a login request becomes a session",
          "steps": [
            {
              "path": "src/auth/login.ts",       from the repo root or the cwd
              "range": [39, 52],                 1-indexed, inclusive
              "title": "Token minted here",      the claim; the panel is narrow
              "note": "What the code does not say.",
              "symbol": "handleLogin"            optional; treesitter fallback
            }
          ]
        }

      anchor.text is read out of the file: the first line of the range is the
      key nvim re-anchors against once the file is edited, so it has to match
      byte for byte. Start a range on a distinctive line. A step copied from
      `show --json` keeps its `anchor`, and create checks it instead: the
      range stays if its first line still matches, moves (with a warning) if
      the text is found once elsewhere in the file, and is refused if it is
      gone. Drop `anchor` from a step you traced again.

      A step with no note is a stub someone pinned to write up later. Stubs
      and steps without titles are written, with a warning.

      Re-running create on an existing id rewrites it, keeping author,
      created_at and the reader's cursor (clamped to the new step count).
      Every rewrite bumps the trail's `rev`. --new refuses an existing id,
      which is how a first write avoids replacing someone else's trail.
      --expect-rev refuses unless the trail is still at that rev. A trail a
      person edited last is only rewritten with a current --expect-rev.

  virgil list                trails for this root, with step counts
  virgil show ID             the compiled trail, as the panel will read it
  virgil show ID --json      the trail as a draft for create, with its rev
  virgil cursor ID [N]       the step the reader is on; with N, drive them
  virgil rm ID               delete a trail

Nothing is written if any step fails validation. Warnings do not block a
write, but each one is a trail that degrades badly once the file moves.
"""

import hashlib
import json
import os
import re
import sys
import time
import unicodedata

PANEL_WIDTH = 38  # lua/virgil/format.lua
MIN_STEPS, MAX_STEPS = 5, 12
MAX_SPAN = 40


def die(msg):
    sys.stderr.write("error: %s\n" % msg)
    sys.exit(1)


def display_width(s):
    w = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def repo_root(start):
    # vim.fs.root(start, ".git"), reimplemented: a worktree's .git is a file.
    cur = os.path.realpath(start)
    while True:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return os.path.realpath(start)
        cur = parent


def data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.join(os.environ["HOME"], ".local", "share")


def repo_key(root):
    # Byte-for-byte what lua/virgil/store.lua does; the README's "Storage"
    # section is the rule both follow.
    raw = os.fsencode(root)
    base = re.sub(rb"[^A-Za-z0-9._-]", b"_", os.path.basename(raw)) or b"root"
    return base.decode("ascii") + "-" + hashlib.sha256(raw).hexdigest()[:12]


def trails_dir(root):
    return os.path.join(data_home(), "virgil", repo_key(root))


def slug(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:48].rstrip("-") or "trail"


def read_lines(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def resolve_path(rel, root):
    """A step path, read as root-relative or cwd-relative, whichever exists.

    Agents run this from wherever they happen to be standing, so both readings
    are plausible; returning the ambiguity is better than picking one and
    pointing a step at the wrong file.
    """
    if os.path.isabs(rel):
        found = os.path.realpath(rel)
        return (found if os.path.isfile(found) else None), None
    seen = []
    for base in (root, os.getcwd()):
        candidate = os.path.realpath(os.path.join(base, rel))
        if os.path.isfile(candidate) and candidate not in seen:
            seen.append(candidate)
    if len(seen) > 1:
        return None, (os.path.relpath(seen[0], root), os.path.relpath(seen[1], root))
    return (seen[0] if seen else None), None


# Key order of a trail file; the README's "Trail file format and write rules"
# section is the contract, and lua/virgil/store.lua encodes the same bytes.
TRAIL_KEYS = ("version", "id", "title", "root", "author", "created_at",
              "updated_by", "updated_at", "rev", "cursor", "steps")
STEP_KEYS = ("path", "title", "range", "anchor", "note")
DRAFT_STEP_KEYS = STEP_KEYS + ("symbol",)
ANCHOR_KEYS = ("text", "symbol")
PERSON_KEYS = ("kind", "name")
ID_PATTERN = r"^[A-Za-z0-9._-]+$"


def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def ordered(value, keys=()):
    """Known keys in contract order, then any others sorted, all the way down."""
    if isinstance(value, list):
        return [ordered(v) for v in value]
    if not isinstance(value, dict):
        return value
    out = {}
    for k in keys:
        if k in value:
            out[k] = value[k]
    for k in sorted(value):
        if k not in out:
            out[k] = ordered(value[k])
    return out


def encode_trail(trail):
    top = ordered(trail, TRAIL_KEYS)
    for key in ("author", "updated_by"):
        if isinstance(top.get(key), dict):
            top[key] = ordered(top[key], PERSON_KEYS)
    if isinstance(top.get("steps"), list):
        steps = []
        for step in top["steps"]:
            step = ordered(step, STEP_KEYS)
            if isinstance(step, dict) and isinstance(step.get("anchor"), dict):
                step["anchor"] = ordered(step["anchor"], ANCHOR_KEYS)
            steps.append(step)
        top["steps"] = steps
    return json.dumps(top, indent=2, ensure_ascii=False) + "\n"


def validate_trail(trail):
    """The first way a trail breaks the write contract, or None.

    Mirrors store.check in lua/virgil/store.lua message for message; the
    contract tests feed both the same fixture files.
    """
    if not isinstance(trail, dict):
        return "not a json object"
    if trail.get("version") != 1 or not is_int(trail.get("version")):
        return "version: must be 1"
    tid = trail.get("id")
    if not isinstance(tid, str) or not re.match(ID_PATTERN, tid):
        return "id: must be a filename of letters, digits, . _ -"
    title = trail.get("title")
    if not isinstance(title, str) or not title.strip():
        return "title: required"
    root = trail.get("root")
    if not isinstance(root, str) or not root:
        return "root: required"
    for key in ("author", "updated_by"):
        if key in trail and not isinstance(trail[key], dict):
            return "%s: must be an object" % key
    for key in ("rev", "cursor"):
        if key in trail and (not is_int(trail[key]) or trail[key] < 0):
            return "%s: must be a non-negative integer" % key
    steps = trail.get("steps")
    if not isinstance(steps, list) or not steps:
        return "steps: required, a non-empty list"
    for i, step in enumerate(steps, 1):
        where = "step %d" % i
        if not isinstance(step, dict):
            return "%s: not an object" % where
        path = step.get("path")
        if not isinstance(path, str) or not path:
            return "%s: path is required" % where
        rng = step.get("range")
        if (not isinstance(rng, list) or len(rng) != 2 or not all(is_int(n) for n in rng)
                or rng[0] < 1 or rng[1] < rng[0]):
            return "%s: range must be [start, end] with 1 <= start <= end" % where
        anchor = step.get("anchor")
        if (not isinstance(anchor, dict) or not isinstance(anchor.get("text"), str)
                or not anchor["text"].strip()):
            return "%s: anchor.text is required and must not be blank" % where
        if "symbol" in anchor and not isinstance(anchor["symbol"], str):
            return "%s: anchor.symbol must be a string" % where
        if "title" in step and not isinstance(step["title"], str):
            return "%s: title must be a string" % where
        if not isinstance(step.get("note"), str):
            return "%s: note must be a string" % where
    return None


def trail_rev(trail):
    rev = trail.get("rev") if isinstance(trail, dict) else None
    return rev if is_int(rev) else 0


def last_editor(trail):
    """Who wrote the trail last: updated_by, else the creator."""
    for key in ("updated_by", "author"):
        who = trail.get(key)
        if isinstance(who, dict):
            return who
    return {}


def describe_person(who):
    kind = who.get("kind") or "unknown"
    name = who.get("name")
    return "%s %s" % (kind, name) if name else kind


def now_utc():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def load_json(raw, what):
    try:
        return json.loads(raw)
    except ValueError as exc:
        die("%s is not valid json: %s" % (what, exc))


def trail_path(root, trail_id):
    return os.path.join(trails_dir(root), trail_id + ".json")


def read_trail(root, trail_id):
    path = trail_path(root, trail_id)
    if not os.path.exists(path):
        die("no trail %s in %s" % (trail_id, trails_dir(root)))
    with open(path, "r", encoding="utf-8") as fh:
        return load_json(fh.read(), path), path


def write_trail(path, trail, check=True):
    # `check` is off only for the reader's cursor, which is not a content write
    # and must not be refused over a hand-written file's shape.
    err = validate_trail(trail) if check else None
    if err:
        die("refusing to write %s: %s" % (path, err))
    # Temp file plus rename, so the fs_event watcher never reads a half trail.
    # The pid keeps two writers from sharing one temp file.
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(encode_trail(trail))
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def compile_trail(draft, root, author, existing):
    errors, warnings = [], []

    if not isinstance(draft, dict):
        die("draft must be a json object with `title` and `steps`")

    title = str(draft.get("title") or "").strip()
    if not title:
        errors.append("title: required, and it is the panel header")
    elif display_width(title) > 72:
        warnings.append("title: %d columns wraps to three panel rows; aim under 72"
                        % display_width(title))

    trail_id = str(draft.get("id") or "").strip() or slug(title)
    if not re.match(ID_PATTERN, trail_id):
        errors.append("id: %r is not a filename; use letters, digits, . _ -" % trail_id)

    raw_steps = draft.get("steps")
    if not isinstance(raw_steps, list) or not raw_steps:
        errors.append("steps: required, a non-empty list")
        raw_steps = []

    # The panel gives a title `width - (number width + 3)` columns before it
    # truncates with an ellipsis.
    title_budget = PANEL_WIDTH - (len(str(max(len(raw_steps), 1))) + 3)

    steps = []
    for i, raw in enumerate(raw_steps, 1):
        where = "step %d" % i
        if not isinstance(raw, dict):
            errors.append("%s: not an object" % where)
            continue

        step_title = str(raw.get("title") or "").strip()
        note = str(raw.get("note") or "").strip()
        rel = str(raw.get("path") or "").strip()

        # A step with no note is a stub: a stop someone pinned to write up
        # later. It is kept, and flagged until someone writes it.
        if not note and not step_title:
            warnings.append("%s is a stub with no title or note yet" % where)
        elif not note:
            warnings.append("%s has no note yet" % where)
        elif not step_title:
            warnings.append("%s: no title, so the panel guesses one from the note's "
                            "first sentence; give it one" % where)
        if step_title and display_width(step_title) > title_budget:
            warnings.append("%s: title is %d columns, panel truncates at %d: %r"
                            % (where, display_width(step_title), title_budget, step_title))
        if not rel:
            errors.append("%s: path is required" % where)
            continue

        abs_path, clash = resolve_path(rel, root)
        if clash:
            errors.append("%s: %s exists both as %s and as %s; give the path from "
                          "the repo root" % (where, rel, clash[0], clash[1]))
            continue
        if not abs_path:
            errors.append("%s: no file at %s, from the repo root or the working "
                          "directory" % (where, rel))
            continue
        if os.path.commonpath([abs_path, root]) != root:
            errors.append("%s: %s is outside the trail root %s" % (where, rel, root))
            continue
        rel = os.path.relpath(abs_path, root)

        rng = raw.get("range")
        if isinstance(rng, int):
            rng = [rng, rng]
        if (not isinstance(rng, list) or not rng
                or not all(isinstance(n, int) for n in rng[:2])):
            errors.append("%s: range must be [start, end] or a single line number" % where)
            continue
        start = rng[0]
        end = rng[1] if len(rng) > 1 else start

        lines = read_lines(abs_path)

        # A supplied anchor is the text someone captured, so it is verified
        # rather than read again from `range`: after an edit above the step,
        # the stored lines point at the wrong code, and only the text knows.
        supplied = raw.get("anchor")
        if supplied is not None:
            if (not isinstance(supplied, dict) or not isinstance(supplied.get("text"), str)
                    or not supplied["text"].strip()):
                errors.append("%s: anchor must be an object whose text is the range's "
                              "first line; drop it to read the anchor from the file" % where)
                continue
            want = supplied["text"]
            if not (1 <= start <= len(lines) and lines[start - 1] == want):
                hits = [n for n, line in enumerate(lines, 1) if line == want]
                if len(hits) != 1:
                    found = ("is no longer in %s" % rel if not hits else
                             "is at %d places in %s, none of them line %d" % (len(hits), rel, start))
                    errors.append("%s: its anchor text %r %s; trace the step again and give "
                                  "a fresh range without `anchor`" % (where, want.strip(), found))
                    continue
                warnings.append("%s: moved from line %d to %d, where its anchor text is now; "
                                "if you traced this step again, drop its `anchor`"
                                % (where, start, hits[0]))
                end, start = hits[0] + (end - start), hits[0]

        if start < 1 or start > len(lines):
            errors.append("%s: line %d is outside %s (%d lines)"
                          % (where, start, rel, len(lines)))
            continue
        if end < start:
            errors.append("%s: range ends (%d) before it starts (%d)" % (where, end, start))
            continue
        if end > len(lines):
            errors.append("%s: range ends at %d but %s has %d lines"
                          % (where, end, rel, len(lines)))
            continue

        anchor_text = lines[start - 1]
        if not anchor_text.strip():
            errors.append("%s: line %d is blank, and the first line of the range is "
                          "the anchor; start on a line with code" % (where, start))
            continue

        symbol = str(raw.get("symbol") or (supplied or {}).get("symbol") or "").strip()
        if lines.count(anchor_text) > 1 and not symbol:
            warnings.append("%s: %s:%d (%r) is not unique in the file, so an edit "
                            "above it breaks the step; start the range on a "
                            "distinctive line, or add a `symbol` to scope it"
                            % (where, rel, start, anchor_text.strip()))
        if end - start + 1 > MAX_SPAN:
            warnings.append("%s: spans %d lines; a range that big is usually two steps "
                            "or a tighter window" % (where, end - start + 1))

        anchor = {"text": anchor_text}
        if symbol:
            anchor["symbol"] = symbol
        step = {k: v for k, v in raw.items() if k not in DRAFT_STEP_KEYS}
        step.update({
            "path": rel,
            "title": step_title,
            "range": [start, end],
            "anchor": anchor,
            "note": note,
        })
        steps.append(step)

    if raw_steps and not errors:
        if len(steps) < MIN_STEPS:
            warnings.append("%d steps: a walk this short is usually the obvious "
                            "shape of the flow rather than a trail" % len(steps))
        elif len(steps) > MAX_STEPS:
            warnings.append("%d steps: cut the ones that are there for flow rather "
                            "than for something the reader could not see" % len(steps))

    if errors:
        for e in errors:
            sys.stderr.write("error: %s\n" % e)
        sys.exit(1)

    existing = existing or {}
    cursor = existing.get("cursor", 0)
    if not is_int(cursor) or cursor < 0 or cursor >= len(steps):
        cursor = 0
    editor = {"kind": "agent", "name": author}
    stamp = now_utc()

    # Fields this CLI does not know about are someone else's; they survive.
    trail = {k: v for k, v in existing.items() if k not in TRAIL_KEYS}
    trail.update({
        "version": 1,
        "id": trail_id,
        "title": title,
        "root": root,
        "author": existing["author"] if isinstance(existing.get("author"), dict) else editor,
        "created_at": existing.get("created_at") or stamp,
        "updated_by": editor,
        "updated_at": stamp,
        "rev": trail_rev(existing) + 1,
        "cursor": cursor,
        "steps": steps,
    })
    return trail, warnings


def step_label(step):
    """The step's title, or what the panel shows for a stub without one."""
    return str(step.get("title") or "").strip() or os.path.basename(step.get("path") or "") or "(step)"


def print_steps(trail):
    numw = len(str(len(trail["steps"])))
    budget = PANEL_WIDTH - (numw + 3)
    for i, step in enumerate(trail["steps"], 1):
        title = step_label(step)
        if display_width(title) > budget:
            title = title[: budget - 1] + "…"
        sys.stdout.write("  %*d  %-*s  %s:%d\n"
                         % (numw, i, budget, title, step["path"], step["range"][0]))


def take_flags(args, names):
    values, rest, i = {}, [], 0
    while i < len(args):
        arg = args[i]
        if arg in names:
            if i + 1 >= len(args):
                die("%s needs a value" % arg)
            values[arg] = args[i + 1]
            i += 2
        elif arg.startswith("--"):
            die("unknown option: %s" % arg)
        else:
            rest.append(arg)
            i += 1
    return values, rest


def take_switches(args, names):
    found = {name: name in args for name in names}
    return found, [a for a in args if a not in names]


def check_overwrite(trail_id, existing, new, expect):
    """Die unless this create may write over what is on disk."""
    if existing is None:
        if expect is not None and expect != 0:
            die("no trail %s to revise (expected rev %d); it was deleted or never "
                "written" % (trail_id, expect))
        return
    rev = trail_rev(existing)
    editor = describe_person(last_editor(existing))
    if new:
        die("trail %s already exists (rev %d, last edited by %s); pick another id, or "
            "revise it: `virgil show %s --json`, then create --expect-rev %d"
            % (trail_id, rev, editor, trail_id, rev))
    if expect is not None and expect != rev:
        die("the trail changed since rev %d (now %d, last edited by %s). "
            "Run `virgil show %s --json` and merge." % (expect, rev, editor, trail_id))
    if expect is None and last_editor(existing).get("kind") == "human":
        die("trail %s was last edited by a person (%s, rev %d), so it is only "
            "rewritten from its current content: run `virgil show %s --json`, "
            "change what was asked, and pass --expect-rev %d"
            % (trail_id, editor, rev, trail_id, rev))


def cmd_create(args):
    switches, args = take_switches(args, ("--new",))
    flags, rest = take_flags(args, ("--from", "--root", "--author", "--expect-rev"))
    if switches["--new"] and "--expect-rev" in flags:
        die("--new and --expect-rev contradict each other")
    expect = None
    if "--expect-rev" in flags:
        try:
            expect = int(flags["--expect-rev"])
        except ValueError:
            die("--expect-rev needs a number, the `rev` printed by show")
    if rest:
        die("create takes no positional arguments (the draft is stdin or --from)")

    root = repo_root(flags.get("--root") or os.getcwd())
    author = flags.get("--author") or os.environ.get("VIRGIL_AUTHOR") or "agent"

    source = flags.get("--from")
    if source:
        if not os.path.isfile(source):
            die("no draft at %s" % source)
        with open(source, "r", encoding="utf-8") as fh:
            raw = fh.read()
    else:
        if sys.stdin.isatty():
            die("no draft on stdin (use --from FILE, or pipe json in)")
        raw = sys.stdin.read()
    draft = load_json(raw, source or "the draft")

    if not isinstance(draft, dict):
        die("draft must be a json object with `title` and `steps`")
    existing = None
    trail_id = str(draft.get("id") or "").strip() or slug(str(draft.get("title") or ""))
    path = trail_path(root, trail_id)
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as fh:
            existing = load_json(fh.read(), path)
        if not isinstance(existing, dict):
            die("%s is not a trail object; remove it with `virgil rm %s`" % (path, trail_id))

    trail, warnings = compile_trail(draft, root, author, existing)
    check_overwrite(trail["id"], existing, switches["--new"], expect)
    write_trail(trail_path(root, trail["id"]), trail)

    for w in warnings:
        sys.stderr.write("warning: %s\n" % w)
    sys.stdout.write("%s %s (%d steps, rev %d)\n"
                     % ("updated" if existing else "wrote",
                        trail_path(root, trail["id"]), len(trail["steps"]), trail["rev"]))
    print_steps(trail)
    sys.stdout.write("  open it with :Virgil %s\n" % trail["id"])
    return 0


def cmd_list(args):
    flags, rest = take_flags(args, ("--root",))
    if rest:
        die("list takes no arguments")
    root = repo_root(flags.get("--root") or os.getcwd())
    directory = trails_dir(root)
    if not os.path.isdir(directory):
        sys.stdout.write("no trails in %s\n" % directory)
        return 0
    found = 0
    for name in sorted(os.listdir(directory)):
        if not name.endswith(".json"):
            continue
        path = os.path.join(directory, name)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                trail = json.load(fh)
        except ValueError as exc:
            sys.stdout.write("%-24s unreadable: %s\n" % (name, exc))
            continue
        if os.path.realpath(trail.get("root", "")) != root:
            continue
        found += 1
        sys.stdout.write("%-24s %d steps, on %d/%d  %s\n"
                         % (trail.get("id", name), len(trail.get("steps", [])),
                            trail.get("cursor", 0) + 1, len(trail.get("steps", [])),
                            trail.get("title", "")))
    if not found:
        sys.stdout.write("no trails for %s in %s\n" % (root, directory))
    return 0


def as_draft(trail):
    """The trail as a draft `create` takes back, anchors included."""
    draft = {"id": trail.get("id"), "title": trail.get("title", ""), "rev": trail_rev(trail)}
    if isinstance(trail.get("updated_by"), dict):
        draft["updated_by"] = trail["updated_by"]
    draft["steps"] = [ordered(s, STEP_KEYS) for s in trail.get("steps", [])]
    return draft


def cmd_show(args):
    switches, args = take_switches(args, ("--json",))
    flags, rest = take_flags(args, ("--root",))
    if len(rest) != 1:
        die("usage: virgil show ID [--json]")
    root = repo_root(flags.get("--root") or os.getcwd())
    trail, path = read_trail(root, rest[0])
    if switches["--json"]:
        sys.stdout.write(json.dumps(as_draft(trail), indent=2, ensure_ascii=False) + "\n")
        return 0
    sys.stdout.write("%s  (%s, %d steps, reader on %d)\n"
                     % (trail.get("title", ""), path, len(trail.get("steps", [])),
                        trail.get("cursor", 0) + 1))
    sys.stdout.write("rev %d, last edited by %s%s\n"
                     % (trail_rev(trail), describe_person(last_editor(trail)),
                        (" at %s" % trail["updated_at"]) if trail.get("updated_at") else ""))
    print_steps(trail)
    for i, step in enumerate(trail.get("steps", []), 1):
        sys.stdout.write("\n%d. %s  %s:%d-%d\n%s\n"
                         % (i, step_label(step), step.get("path", ""),
                            step.get("range", [0, 0])[0], step.get("range", [0, 0])[-1],
                            step.get("note") or "(no note yet)"))
    return 0


def cmd_cursor(args):
    flags, rest = take_flags(args, ("--root",))
    if not rest or len(rest) > 2:
        die("usage: virgil cursor ID [N]")
    root = repo_root(flags.get("--root") or os.getcwd())
    trail, path = read_trail(root, rest[0])
    total = len(trail.get("steps", []))

    if len(rest) == 1:
        index = trail.get("cursor", 0)
        step = trail["steps"][index] if 0 <= index < total else {}
        sys.stdout.write("%d/%d  %s\n" % (index + 1, total, step_label(step) if step else ""))
        return 0

    try:
        want = int(rest[1])
    except ValueError:
        die("step must be a number between 1 and %d" % total)
    if want < 1 or want > total:
        die("step %d is outside this trail (1-%d)" % (want, total))
    trail["cursor"] = want - 1
    write_trail(path, trail, check=False)
    sys.stdout.write("%d/%d  %s\n" % (want, total, step_label(trail["steps"][want - 1])))
    return 0


def cmd_rm(args):
    flags, rest = take_flags(args, ("--root",))
    if len(rest) != 1:
        die("usage: virgil rm ID")
    root = repo_root(flags.get("--root") or os.getcwd())
    _, path = read_trail(root, rest[0])
    os.remove(path)
    sys.stdout.write("removed %s\n" % path)
    return 0


COMMANDS = {
    "create": cmd_create,
    "list": cmd_list,
    "show": cmd_show,
    "cursor": cmd_cursor,
    "rm": cmd_rm,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__.strip() + "\n")
        return 0
    handler = COMMANDS.get(argv[0])
    if not handler:
        die("unknown command %r (try --help)" % argv[0])
    return handler(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
